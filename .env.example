# ==============================================================================
# APEXSTORE ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application & Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"

# Database Connection (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apexstore?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apexstore?schema=public"

# Authentication & Session Security
JWT_SECRET="replace-with-at-least-64-character-cryptographic-secret"
JWT_EXPIRES_IN="7d"

# Stripe Payment Gateway
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sampleStripePublishableKey12345"
STRIPE_SECRET_KEY="sk_test_sampleStripeSecretKey12345"
STRIPE_WEBHOOK_SECRET="whsec_sampleStripeWebhookSecret12345"

# Email Gateway (Resend)
RESEND_API_KEY="re_sampleResendApiKey12345"
EMAIL_SENDER_ADDRESS="ApexStore <orders@apexstore.com>"

# Media Storage CDN (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="apexstore"
CLOUDINARY_API_KEY="sampleCloudinaryApiKey"
CLOUDINARY_API_SECRET="sampleCloudinaryApiSecret"

# Rate Limiting & Distributed Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sampleUpstashToken"
